[sub_resource type="Shader" id="Shader_11bse"]
code = "shader_type spatial;
// cull_back: 剔除背面，提升性能
// depth_draw_opaque: 强制按不透明物体写入深度，彻底遮挡内部的网格墙壁
render_mode cull_back, depth_draw_opaque;

uniform vec4 base_color : source_color = vec4(0.98, 0.98, 1.0, 1.0);
uniform float day_night_factor : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	// 【核心1】：强制完全不透明！这是消除内部网格墙壁的最关键一步！
	ALBEDO = base_color.rgb;
	ALPHA = 1.0;

	// 【核心2】：根据方块的面（法线方向）来做微小的假光影
	// 让云有立体的厚度感，但又不会显露方块与方块之间的缝隙
	float face_shade = 1.0;
	if (NORMAL.y > 0.5) {
		face_shade = 1.0;   // 云的顶面受光最多，最亮
	} else if (NORMAL.y < -0.5) {
		face_shade = 0.8;   // 云的底面背光，稍微暗一点点
	} else {
		face_shade = 0.9;   // 云的侧面亮度介于中间
	}

	// 结合脚本传进来的昼夜因子（白天亮，晚上暗）
	// mix(0.1, 1.0, ...) 确保晚上即使再黑，云也有一点点轮廓（0.1）
	float brightness = mix(0.1, 1.0, day_night_factor) * face_shade;

	// 全部用自发光输出，彻底抛弃环境本身的复杂阴影
	EMISSION = base_color.rgb * brightness;

	// 避免像塑料一样反光
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}

// 【核心3】：屏蔽原生的动态光照！
// 加上这个函数，太阳光就不会在方块接缝处投射恶心的细碎阴影了
void light() {
	DIFFUSE_LIGHT = vec3(0.0);
}"

